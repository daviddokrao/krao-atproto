{
  "name": "@krao/push",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Krao push service: device tokens and push notifications over FCM and APNs, in place of Bluesky's courier",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "krao-push": "./dist/bin.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@atproto/identity": "workspace:^",
    "@atproto/sync": "workspace:^",
    "@bufbuild/protobuf": "~1.6.0",
    "@connectrpc/connect": "^1.1.4",
    "@connectrpc/connect-express": "^1.1.4",
    "better-sqlite3": "^12.0.0",
    "express": "^4.17.2",
    "kysely": "^0.29.2",
    "pg": "^8.10.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.73.0",
    "@bufbuild/protoc-gen-es": "^1.5.0",
    "@connectrpc/connect-node": "^1.1.4",
    "@connectrpc/protoc-gen-connect-es": "^1.7.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.13",
    "@types/pg": "^8.15.5",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "codegen:buf": "buf generate ./proto",
    "prebuild": "pnpm run '/^(codegen:.+)$/'",
    "build": "tsc --build tsconfig.build.json",
    "test": "vitest run",
    "start": "node --enable-source-maps dist/bin.js"
  }
}
