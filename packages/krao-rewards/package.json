{
  "name": "@krao/rewards",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Krao rewards service: referral codes, points ledger, reward rules and KYC",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "krao-rewards": "./dist/bin.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@atproto/identity": "workspace:^",
    "@atproto/lex": "workspace:^",
    "@atproto/syntax": "workspace:^",
    "@atproto/xrpc-server": "workspace:^",
    "better-sqlite3": "^12.0.0",
    "cors": "^2.8.5",
    "express": "^4.17.2",
    "kysely": "^0.29.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "codegen:lex": "lex build --clear --indexFile --lexicons ../../lexicons --include 'net.krao.referral.*' 'net.krao.points.*' 'net.krao.kyc.*' 'net.krao.rewards.*' 'net.krao.phone.*' 'net.krao.account.*' 'net.krao.push.*'",
    "prebuild": "pnpm run '/^(codegen:.+)$/'",
    "build": "tsc --build tsconfig.build.json",
    "test": "vitest run",
    "start": "node --enable-source-maps dist/bin.js"
  }
}
