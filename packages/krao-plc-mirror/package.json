{
  "name": "@krao/plc-mirror",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Krao PLC mirror: a read-only copy of a did:plc directory, checked op by op, that Krao's services resolve DIDs through",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "krao-plc-mirror": "./dist/bin.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@did-plc/lib": "^0.0.4",
    "better-sqlite3": "^12.0.0",
    "express": "^4.17.2",
    "kysely": "^0.29.2"
  },
  "devDependencies": {
    "@atproto/crypto": "workspace:^",
    "@did-plc/server": "^0.0.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.13",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "test": "vitest run",
    "start": "node --enable-source-maps dist/bin.js"
  }
}
