{
  "lexicon": 1,
  "id": "io.krao.feed.getTips",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get tips sent to a post, or to an account when no post is given. Only verified tips are counted in the totals.",
      "parameters": {
        "type": "params",
        "properties": {
          "subject": {
            "type": "string",
            "format": "at-uri",
            "description": "Post to get tips for."
          },
          "recipient": {
            "type": "string",
            "format": "at-identifier",
            "description": "Account to get tips for. Ignored when subject is set."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "cursor": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["tips", "totals"],
          "properties": {
            "tips": {
              "type": "array",
              "items": { "type": "ref", "ref": "io.krao.feed.defs#tipView" }
            },
            "totals": {
              "type": "array",
              "items": { "type": "ref", "ref": "io.krao.feed.defs#tipTotal" }
            },
            "cursor": { "type": "string" }
          }
        }
      }
    }
  }
}
