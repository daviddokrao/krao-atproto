{
  "lexicon": 1,
  "id": "net.krao.rewards.admin.listRules",
  "defs": {
    "main": {
      "type": "query",
      "description": "All reward rules. Admins only (service auth from a DID in the service's admin list).",
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["rules"],
          "properties": {
            "rules": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "net.krao.rewards.admin.defs#rule"
              }
            }
          }
        }
      }
    }
  }
}
