{
  "lexicon": 1,
  "id": "net.krao.rewards.admin.listKyc",
  "defs": {
    "main": {
      "type": "query",
      "description": "KYC records, newest change first. Admins only (service auth from a DID in the service's admin list).",
      "parameters": {
        "type": "params",
        "required": [],
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "cursor": {
            "type": "string",
            "maxLength": 512
          },
          "status": {
            "type": "string",
            "knownValues": ["none", "pending", "retry", "approved", "rejected"]
          },
          "did": {
            "type": "string",
            "format": "did"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["records"],
          "properties": {
            "records": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "net.krao.rewards.admin.defs#kycRecord"
              }
            },
            "cursor": {
              "type": "string",
              "maxLength": 512
            }
          }
        }
      }
    }
  }
}
