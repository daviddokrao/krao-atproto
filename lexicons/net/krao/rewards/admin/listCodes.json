{
  "lexicon": 1,
  "id": "net.krao.rewards.admin.listCodes",
  "defs": {
    "main": {
      "type": "query",
      "description": "Referral codes, newest first. Admins only (service auth from a DID in the service's admin list).",
      "parameters": {
        "type": "params",
        "required": [],
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "cursor": {
            "type": "string",
            "maxLength": 512
          },
          "kind": {
            "type": "string",
            "knownValues": ["personal", "campaign", "partner"]
          },
          "ownerDid": {
            "type": "string",
            "format": "did"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["codes"],
          "properties": {
            "codes": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "net.krao.rewards.admin.defs#codeView"
              }
            },
            "cursor": {
              "type": "string",
              "maxLength": 512
            }
          }
        }
      }
    }
  }
}
