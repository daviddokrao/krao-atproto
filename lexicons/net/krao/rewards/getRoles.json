{
  "lexicon": 1,
  "id": "net.krao.rewards.getRoles",
  "defs": {
    "main": {
      "type": "query",
      "description": "The viewer's admin roles in the rewards service: what admin screens the app may show. Requires service auth for the rewards service.",
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "roles"
          ],
          "properties": {
            "roles": {
              "type": "array",
              "items": {
                "type": "string",
                "knownValues": [
                  "admin",
                  "kyc_reviewer"
                ]
              }
            }
          }
        }
      }
    }
  }
}
