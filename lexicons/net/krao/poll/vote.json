{
  "lexicon": 1,
  "id": "net.krao.poll.vote",
  "defs": {
    "main": {
      "type": "record",
      "description": "A vote in a poll. Public, like every record. Only the voter's first valid vote counts; votes cannot be changed, and a deleted vote stops counting without freeing a new one.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["poll", "option", "createdAt"],
        "properties": {
          "poll": { "type": "ref", "ref": "com.atproto.repo.strongRef" },
          "option": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3,
            "description": "Index of the chosen option."
          },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
