{
  "lexicon": 1,
  "id": "net.krao.points.listEntries",
  "defs": {
    "main": {
      "type": "query",
      "description": "The viewer's points ledger, newest first. Requires service auth for the rewards service.",
      "parameters": {
        "type": "params",
        "required": [],
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "cursor": {
            "type": "string",
            "maxLength": 512
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["entries"],
          "properties": {
            "entries": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "net.krao.points.defs#entryView"
              }
            },
            "cursor": {
              "type": "string",
              "maxLength": 512
            }
          }
        }
      }
    }
  }
}
