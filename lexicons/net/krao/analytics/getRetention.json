{
  "lexicon": 1,
  "id": "net.krao.analytics.getRetention",
  "defs": {
    "main": {
      "type": "query",
      "description": "Retention by sign-up week: the last `weeks` weeks (Vietnam time), the current one included, the oldest first. Rewards admins only (service auth).",
      "parameters": {
        "type": "params",
        "properties": {
          "weeks": {
            "type": "integer",
            "minimum": 1,
            "maximum": 26,
            "default": 8
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["cohorts"],
          "properties": {
            "cohorts": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "net.krao.analytics.defs#cohort"
              }
            }
          }
        }
      }
    }
  }
}
