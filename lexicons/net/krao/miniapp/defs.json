{
  "lexicon": 1,
  "id": "net.krao.miniapp.defs",
  "defs": {
    "miniAppView": {
      "type": "object",
      "required": [
        "uri",
        "cid",
        "developer",
        "name",
        "url",
        "origin",
        "permissions",
        "status",
        "indexedAt"
      ],
      "properties": {
        "uri": { "type": "string", "format": "at-uri" },
        "cid": { "type": "string", "format": "cid" },
        "developer": { "type": "string", "format": "did" },
        "name": { "type": "string", "maxLength": 640 },
        "description": { "type": "string", "maxLength": 3000 },
        "url": { "type": "string", "maxLength": 2048 },
        "origin": { "type": "string", "maxLength": 2048 },
        "iconUrl": {
          "type": "string",
          "format": "uri",
          "description": "The icon through Krao's image proxy (PNG)."
        },
        "permissions": {
          "type": "array",
          "items": { "type": "string", "maxLength": 32 }
        },
        "chains": {
          "type": "array",
          "items": { "type": "string", "maxLength": 64 }
        },
        "status": {
          "type": "string",
          "description": "'approved': this CID was approved; 'pending': waiting for review (new or changed); 'revoked': taken down by Krao, or its developer account or domain was; 'invalid': the record breaks the rules (eg not https, Krao's own origin).",
          "knownValues": ["approved", "pending", "revoked", "invalid"],
          "maxLength": 16
        },
        "revokedReason": { "type": "string", "maxLength": 1000 },
        "invalidReason": { "type": "string", "maxLength": 1000 },
        "approvedAt": { "type": "string", "format": "datetime" },
        "indexedAt": { "type": "string", "format": "datetime" }
      }
    }
  }
}
