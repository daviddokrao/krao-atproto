{
  "lexicon": 1,
  "id": "net.krao.miniapp.admin.revoke",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Take a Mini App down: it stops running in Krao, whatever version its record holds, until it is approved again. Safety admins only (logged); requires service auth for the indexer.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["uri"],
          "properties": {
            "uri": { "type": "string", "format": "at-uri" },
            "reason": { "type": "string", "maxLength": 1000 }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["app"],
          "properties": {
            "app": { "type": "ref", "ref": "net.krao.miniapp.defs#miniAppView" }
          }
        }
      },
      "errors": [{ "name": "NotFound" }]
    }
  }
}
