{
  "lexicon": 1,
  "id": "net.krao.token.admin.removeToken",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Take a token out of Krao's catalog (seed tokens too: they stay out after a restart). Its price history and cashtag posts are dropped. Token admins only; requires service auth for the indexer.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["symbol"],
          "properties": {
            "symbol": { "type": "string", "maxLength": 17 }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["removed"],
          "properties": {
            "removed": { "type": "boolean" }
          }
        }
      }
    }
  }
}
