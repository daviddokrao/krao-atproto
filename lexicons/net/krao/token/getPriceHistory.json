{
  "lexicon": 1,
  "id": "net.krao.token.getPriceHistory",
  "defs": {
    "main": {
      "type": "query",
      "description": "Prices of a catalog token over a time range, oldest first. Prices are read every 5 minutes; longer ranges keep the last price of each 30-minute (7d) or 2-hour (30d) bucket.",
      "parameters": {
        "type": "params",
        "required": ["symbol"],
        "properties": {
          "symbol": {
            "type": "string",
            "description": "The symbol, with or without '$'; case is ignored.",
            "maxLength": 17
          },
          "range": {
            "type": "string",
            "knownValues": ["1d", "7d", "30d"],
            "default": "1d",
            "maxLength": 8
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["points"],
          "properties": {
            "points": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "net.krao.token.defs#pricePoint"
              }
            }
          }
        }
      },
      "errors": [
        {
          "name": "NotFound",
          "description": "No token with this symbol in the catalog."
        }
      ]
    }
  }
}
