{
  "lexicon": 1,
  "id": "net.krao.token.getFeed",
  "defs": {
    "main": {
      "type": "query",
      "description": "Posts by Krao accounts that mention a catalog token as a cashtag (eg $ETH, in the text or as a tag facet), newest first. Hydrate them with app.bsky.feed.getPosts.",
      "parameters": {
        "type": "params",
        "required": ["symbol"],
        "properties": {
          "symbol": {
            "type": "string",
            "description": "The symbol, with or without '$'; case is ignored.",
            "maxLength": 17
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 30
          },
          "cursor": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["feed"],
          "properties": {
            "feed": {
              "type": "array",
              "items": { "type": "ref", "ref": "net.krao.token.defs#feedItem" }
            },
            "cursor": { "type": "string" }
          }
        }
      },
      "errors": [
        {
          "name": "NotFound",
          "description": "No token with this symbol in the catalog."
        }
      ]
    }
  }
}
