{
  "lexicon": 1,
  "id": "net.krao.community.getPendingMembers",
  "defs": {
    "main": {
      "type": "query",
      "description": "Accounts waiting for approval to join an 'approval' community, the oldest first. The owner and moderators only; requires service auth for the indexer (the gate service DID).",
      "parameters": {
        "type": "params",
        "required": ["community"],
        "properties": {
          "community": { "type": "string", "format": "at-uri" },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "cursor": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["members"],
          "properties": {
            "members": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "net.krao.community.defs#memberView"
              }
            },
            "cursor": { "type": "string" }
          }
        }
      },
      "errors": [{ "name": "NotFound" }, { "name": "NotModerator" }]
    }
  }
}
