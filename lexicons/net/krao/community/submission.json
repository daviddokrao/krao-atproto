{
  "lexicon": 1,
  "id": "net.krao.community.submission",
  "defs": {
    "main": {
      "type": "record",
      "description": "Posts one of the author's own posts to a community. The community feed lists the submissions of its members, without hidden posts and banned accounts.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["community", "post", "createdAt"],
        "properties": {
          "community": { "type": "string", "format": "at-uri" },
          "post": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef",
            "description": "A post in the same repo as this record."
          },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
