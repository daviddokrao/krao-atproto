{
  "lexicon": 1,
  "id": "net.krao.community.profile",
  "defs": {
    "main": {
      "type": "record",
      "description": "A Krao community, owned by the account whose repo holds this record. The record key is the community's slug: 3 to 40 characters of a-z, 0-9 and '-'.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["name", "access", "createdAt"],
        "properties": {
          "name": {
            "type": "string",
            "maxGraphemes": 64,
            "maxLength": 640
          },
          "description": {
            "type": "string",
            "maxGraphemes": 300,
            "maxLength": 3000
          },
          "avatar": {
            "type": "blob",
            "accept": ["image/png", "image/jpeg"],
            "maxSize": 1000000
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string",
              "maxGraphemes": 300,
              "maxLength": 3000
            },
            "maxLength": 10
          },
          "access": { "type": "ref", "ref": "net.krao.community.defs#access" },
          "chatJoinLink": {
            "type": "string",
            "format": "uri",
            "description": "Join link of the community's Krao chat group, if any."
          },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
