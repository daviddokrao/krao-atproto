{
  "lexicon": 1,
  "id": "net.krao.community.membership",
  "defs": {
    "main": {
      "type": "record",
      "description": "Joins a community. Whether the membership is valid depends on the community's access mode (see net.krao.community.defs#access). Delete the record to leave.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["subject", "createdAt"],
        "properties": {
          "subject": {
            "type": "string",
            "format": "at-uri",
            "description": "The net.krao.community.profile record."
          },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
