{
  "lexicon": 1,
  "id": "net.krao.community.getCommunity",
  "defs": {
    "main": {
      "type": "query",
      "description": "A community with its member count. With service auth for the indexer (the gate service DID), also the caller's membership state, checked on-chain or with Krao's verification for 'condition' and 'verified' communities. Without auth, no viewer state. Rate limited.",
      "parameters": {
        "type": "params",
        "required": ["uri"],
        "properties": {
          "uri": { "type": "string", "format": "at-uri" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["community"],
          "properties": {
            "community": {
              "type": "ref",
              "ref": "net.krao.community.defs#communityView"
            }
          }
        }
      },
      "errors": [{ "name": "NotFound" }]
    }
  }
}
