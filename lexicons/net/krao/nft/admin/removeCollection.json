{
  "lexicon": 1,
  "id": "net.krao.nft.admin.removeCollection",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Take an NFT collection off Krao's approved list. Safety admins only; requires service auth for the indexer.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["chain", "contract"],
          "properties": {
            "chain": { "type": "string", "maxLength": 128 },
            "contract": { "type": "string", "maxLength": 128 }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["removed"],
          "properties": {
            "removed": { "type": "boolean" }
          }
        }
      }
    }
  }
}
