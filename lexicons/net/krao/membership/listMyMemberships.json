{
  "lexicon": 1,
  "id": "net.krao.membership.listMyMemberships",
  "defs": {
    "main": {
      "type": "query",
      "description": "Memberships of the caller (every creator the caller wrote a payment to), the most recently paid first. Requires service auth for the indexer (the gate service DID).",
      "parameters": {
        "type": "params",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "cursor": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["memberships"],
          "properties": {
            "memberships": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "net.krao.membership.defs#membershipView"
              }
            },
            "cursor": { "type": "string" }
          }
        }
      }
    }
  }
}
