{
  "lexicon": 1,
  "id": "net.krao.safety.admin.listDomains",
  "defs": {
    "main": {
      "type": "query",
      "description": "Unsafe domains, newest first. Safety admins only; requires service auth for the indexer.",
      "parameters": {
        "type": "params",
        "properties": {
          "source": {
            "type": "string",
            "knownValues": ["list", "admin", "admin_allow", "seed"]
          },
          "query": {
            "type": "string",
            "maxLength": 253,
            "description": "Only domains containing this text."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "cursor": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["domains"],
          "properties": {
            "domains": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "net.krao.safety.defs#domainView"
              }
            },
            "cursor": { "type": "string" }
          }
        }
      }
    }
  }
}
