{
  "lexicon": 1,
  "id": "net.krao.gate.getRules",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get the token gates for a set of posts. Posts without a gate are omitted.",
      "parameters": {
        "type": "params",
        "required": ["uris"],
        "properties": {
          "uris": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "at-uri"
            },
            "maxLength": 25
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["rules"],
          "properties": {
            "rules": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "net.krao.gate.defs#ruleView"
              }
            }
          }
        }
      }
    }
  }
}
