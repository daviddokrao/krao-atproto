{
  "lexicon": 1,
  "id": "net.krao.gate.defs",
  "defs": {
    "tokenBalance": {
      "type": "object",
      "description": "Satisfied when the viewer's linked wallets together hold at least minAmount of the asset.",
      "required": ["asset", "minAmount"],
      "properties": {
        "asset": {
          "type": "ref",
          "ref": "net.krao.chain.defs#assetId"
        },
        "minAmount": {
          "type": "string",
          "description": "Minimum balance in the asset's smallest unit, as a decimal integer string.",
          "maxLength": 80
        }
      }
    },
    "nftHolding": {
      "type": "object",
      "description": "Satisfied when a linked wallet holds any token of the collection, or the specific token when tokenId is set.",
      "required": ["chain", "contract"],
      "properties": {
        "chain": {
          "type": "ref",
          "ref": "net.krao.chain.defs#chainId"
        },
        "contract": {
          "type": "string",
          "maxLength": 128
        },
        "tokenId": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "communityMember": {
      "type": "object",
      "description": "Satisfied when the viewer is a member in good standing of the community (net.krao.community.profile): its owner, a moderator, or an account whose membership counts and who is not banned.",
      "required": ["community"],
      "properties": {
        "community": {
          "type": "string",
          "format": "at-uri",
          "description": "URI of the net.krao.community.profile record."
        }
      }
    },
    "media": {
      "type": "object",
      "description": "Media hosted by the gate service, served only to eligible viewers.",
      "required": ["url", "mimeType"],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "mimeType": {
          "type": "string",
          "maxLength": 128
        },
        "alt": {
          "type": "string",
          "maxLength": 10000,
          "maxGraphemes": 1000
        },
        "aspectRatio": {
          "type": "ref",
          "ref": "app.bsky.embed.defs#aspectRatio"
        }
      }
    },
    "gatedContent": {
      "type": "object",
      "required": ["uri"],
      "properties": {
        "uri": {
          "type": "string",
          "format": "at-uri",
          "description": "The public post this content belongs to."
        },
        "text": {
          "type": "string",
          "maxLength": 30000,
          "maxGraphemes": 3000
        },
        "facets": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "app.bsky.richtext.facet"
          }
        },
        "media": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "#media"
          },
          "maxLength": 4
        }
      }
    },
    "ruleView": {
      "type": "object",
      "description": "A token gate on a post, as indexed from its net.krao.gate.rule record.",
      "required": ["uri", "subject", "conditions", "match", "service"],
      "properties": {
        "uri": {
          "type": "string",
          "format": "at-uri",
          "description": "URI of the net.krao.gate.rule record."
        },
        "subject": {
          "type": "string",
          "format": "at-uri",
          "description": "The gated post."
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "union",
            "refs": ["#tokenBalance", "#nftHolding", "#communityMember"]
          }
        },
        "match": {
          "type": "string",
          "knownValues": ["all", "any"],
          "maxLength": 16
        },
        "service": {
          "type": "string",
          "format": "did"
        },
        "hasContent": {
          "type": "boolean",
          "description": "Whether the author has stored gated content for the post on this service."
        }
      }
    }
  }
}
