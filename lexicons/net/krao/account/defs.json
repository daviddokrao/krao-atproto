{
  "lexicon": 1,
  "id": "net.krao.account.defs",
  "defs": {
    "consentView": {
      "type": "object",
      "required": ["version", "items", "createdAt"],
      "properties": {
        "version": { "type": "string", "maxLength": 32 },
        "items": {
          "type": "array",
          "items": {
            "type": "string",
            "knownValues": ["terms", "privacy", "kyc", "phone", "wallet"]
          }
        },
        "createdAt": { "type": "string", "format": "datetime" }
      }
    }
  }
}
