{
  "lexicon": 1,
  "id": "net.krao.account.getConsent",
  "defs": {
    "main": {
      "type": "query",
      "description": "The viewer's consent records, newest first. Requires service auth for the rewards service.",
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["consents"],
          "properties": {
            "consents": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "net.krao.account.defs#consentView"
              }
            }
          }
        }
      }
    }
  }
}
