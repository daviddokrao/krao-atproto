{
  "lexicon": 1,
  "id": "net.krao.actor.defs",
  "defs": {
    "walletView": {
      "type": "object",
      "required": ["uri", "account", "status"],
      "properties": {
        "uri": {
          "type": "string",
          "format": "at-uri",
          "description": "URI of the net.krao.actor.wallet record."
        },
        "account": {
          "type": "ref",
          "ref": "net.krao.chain.defs#accountId"
        },
        "label": {
          "type": "string",
          "maxLength": 640,
          "maxGraphemes": 64
        },
        "status": {
          "type": "ref",
          "ref": "net.krao.chain.defs#verificationStatus"
        },
        "reason": {
          "type": "string",
          "maxLength": 300,
          "description": "Why the wallet does not count, when its status is invalid (for example: another account linked it first)."
        },
        "showPrimaryName": {
          "type": "boolean",
          "description": "False when the owner chose not to show this wallet's Basename/ENS name (the record's showPrimaryName). Absent means shown."
        },
        "createdAt": {
          "type": "string",
          "format": "datetime"
        }
      }
    },
    "nftAvatarView": {
      "type": "object",
      "required": ["nft", "wallet", "status"],
      "properties": {
        "nft": {
          "type": "ref",
          "ref": "net.krao.chain.defs#nftRef"
        },
        "wallet": {
          "type": "ref",
          "ref": "net.krao.chain.defs#accountId"
        },
        "status": {
          "type": "ref",
          "ref": "net.krao.chain.defs#verificationStatus"
        },
        "collectionName": {
          "type": "string",
          "maxLength": 640
        },
        "checkedAt": {
          "type": "string",
          "format": "datetime",
          "description": "When ownership was last checked on-chain."
        },
        "image": {
          "type": "string",
          "format": "uri",
          "description": "Image of the NFT from its token metadata."
        }
      }
    },
    "chainProfileView": {
      "type": "object",
      "description": "Web3 details for an account, shown alongside its regular app.bsky profile.",
      "required": ["did", "wallets"],
      "properties": {
        "did": {
          "type": "string",
          "format": "did"
        },
        "wallets": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "#walletView"
          }
        },
        "nftAvatar": {
          "type": "ref",
          "ref": "#nftAvatarView"
        },
        "primaryName": {
          "type": "ref",
          "ref": "#primaryNameView"
        },
        "tipsReceivedCount": {
          "type": "integer",
          "description": "Number of verified tips this account has received."
        },
        "badges": {
          "type": "array",
          "description": "Badges earned from verified on-chain activity.",
          "items": {
            "type": "ref",
            "ref": "#badge"
          }
        }
      }
    },
    "primaryNameView": {
      "type": "object",
      "description": "A verified Basename or ENS name of one of the account's verified wallets: the wallet's reverse record names it, and the name resolves to the same address. At most one per account, Basenames first.",
      "required": ["name", "source", "address"],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 255,
          "description": "Lowercase ASCII name, eg alice.base.eth."
        },
        "source": {
          "type": "string",
          "knownValues": ["basename", "ens"]
        },
        "address": {
          "type": "string",
          "maxLength": 42,
          "description": "The wallet address (lowercase 0x hex) the name belongs to."
        }
      }
    },
    "badge": {
      "type": "object",
      "description": "A badge computed from verified on-chain activity.",
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "knownValues": [
            "wallet-verified",
            "nft-avatar",
            "tipper",
            "supported"
          ]
        },
        "count": {
          "type": "integer",
          "description": "How many times the underlying activity happened, when relevant."
        }
      }
    }
  }
}
