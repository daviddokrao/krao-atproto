# Krao production settings for docker-compose.yml. Copy to .env and fill
# every value; compose refuses to start while a required one is missing.
# Generate secrets with:  openssl rand -base64 36
# Generate keys (secp256k1, hex) with:  openssl rand -hex 32

# --- Network ---------------------------------------------------------------
# Every service lives under this domain: pds., api., mod., idx., chat.,
# video., rewards.<domain>, and user handles are <name>.<domain>.
# DNS: A records for each of these and a wildcard *.<domain> to this host.
KRAO_DOMAIN=krao.net
KRAO_ACME_EMAIL=ops@krao.net
# The DID directory. plc.directory is the shared public one.
KRAO_PLC_URL=https://plc.directory

# --- Database --------------------------------------------------------------
POSTGRES_PASSWORD=

# --- PDS -------------------------------------------------------------------
PDS_JWT_SECRET=
PDS_ADMIN_PASSWORD=
# Controls every account's DID: back it up offline
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=
# For email confirmation and password resets, e.g. smtps://user:pass@host:465
PDS_EMAIL_SMTP_URL=
PDS_EMAIL_FROM_ADDRESS=

# --- AppView, bsync --------------------------------------------------------
BSKY_SERVICE_SIGNING_KEY=
BSKY_ADMIN_PASSWORD=
BSYNC_API_KEY=

# --- Moderation (Ozone) ----------------------------------------------------
OZONE_SIGNING_KEY_HEX=
# Only to create the DID (create-ozone-did.mjs); then keep it offline
OZONE_ROTATION_KEY_HEX=
# Printed by create-ozone-did.mjs
OZONE_SERVER_DID=
OZONE_ADMIN_PASSWORD=
# Comma-separated DIDs of the moderators' accounts
OZONE_ADMIN_DIDS=

# --- Krao services ---------------------------------------------------------
# Shared by the PDS and rewards (at least 32 characters)
KRAO_REWARDS_INTERNAL_TOKEN=
# Signs gated media URLs (at least 32 characters)
KRAO_GATE_MEDIA_SECRET=
# The AppView's key for the push service, and Krao services' token for it
KRAO_PUSH_COURIER_KEY=
KRAO_PUSH_INTERNAL_TOKEN=
# Chains the indexer checks (tips, gates, NFTs): JSON {chain id: RPC URL}
KRAO_RPC_URLS={"eip155:8453":"https://mainnet.base.org"}
KRAO_KLIPY_API_KEY=
# A campaign code for the first accounts (the admins); remove it, and
# disable the code in the admin screen, once they have signed up
KRAO_REWARDS_BOOTSTRAP_CODE=
KRAO_REWARDS_ADMIN_DIDS=
KRAO_KYC_REVIEWER_DIDS=
KRAO_KYC_MANUAL_DAILY_LIMIT=
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=
SUMSUB_LEVEL=

# --- S3 (gated media and backups) ------------------------------------------
# Any S3-compatible store (AWS, Cloudflare R2, Backblaze B2, MinIO).
# The gated media bucket must be private.
KRAO_S3_ACCESS_KEY_ID=
KRAO_S3_SECRET_ACCESS_KEY=
KRAO_GATE_MEDIA_S3_BUCKET=
KRAO_GATE_MEDIA_S3_REGION=
KRAO_GATE_MEDIA_S3_ENDPOINT=
KRAO_GATE_MEDIA_S3_PATH_STYLE=

# --- Push notifications ----------------------------------------------------
# Files in ./secrets (mounted at /secrets). Without both, pushes are logged.
# Android: a Firebase service account JSON for the io.krao.app project
KRAO_PUSH_FCM_SERVICE_ACCOUNT_FILE=
# iOS: an APNs auth key (.p8) with its key id and team id
KRAO_PUSH_APNS_KEY_FILE=
KRAO_PUSH_APNS_KEY_ID=
KRAO_PUSH_APNS_TEAM_ID=
KRAO_PUSH_APNS_TOPIC=io.krao.app

# --- Backups ---------------------------------------------------------------
KRAO_BACKUP_DIR=./backups
KRAO_BACKUP_EVERY_HOURS=24
KRAO_BACKUP_KEEP=7
# Also copy each backup to this bucket (recommended: another provider)
KRAO_BACKUP_S3_BUCKET=
KRAO_BACKUP_S3_REGION=
KRAO_BACKUP_S3_ENDPOINT=
