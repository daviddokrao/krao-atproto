# Krao production settings for docker-compose.yml. Copy to .env and fill
# every value; compose refuses to start while a required one is missing.
# Generate secrets with:  openssl rand -base64 36
# Generate keys (secp256k1, hex) with:  openssl rand -hex 32

# --- Network ---------------------------------------------------------------
# Every service lives under this domain: pds., api., mod., idx., chat.,
# video., rewards.<domain>, and user handles are <name>.<domain>.
# DNS: A records for each of these and a wildcard *.<domain> to this host.
KRAO_DOMAIN=krao.net
KRAO_ACME_EMAIL=ops@krao.net
# The DID directory. plc.directory is the shared public one.
KRAO_PLC_URL=https://plc.directory

# --- Database --------------------------------------------------------------
POSTGRES_PASSWORD=

# --- PDS -------------------------------------------------------------------
# Repo imports (com.atproto.repo.importRepo, for accounts moving in) stay off
# unless set to true; imported posts also need a verified phone
PDS_ACCEPTING_REPO_IMPORTS=false
PDS_JWT_SECRET=
PDS_ADMIN_PASSWORD=
# Controls every account's DID: back it up offline
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=
# For email confirmation and password resets, e.g. smtps://user:pass@host:465
PDS_EMAIL_SMTP_URL=
PDS_EMAIL_FROM_ADDRESS=

# --- AppView, bsync --------------------------------------------------------
BSKY_SERVICE_SIGNING_KEY=
BSKY_ADMIN_PASSWORD=
BSYNC_API_KEY=

# --- Moderation (Ozone) ----------------------------------------------------
OZONE_SIGNING_KEY_HEX=
# Only to create the DID (create-ozone-did.mjs); then keep it offline
OZONE_ROTATION_KEY_HEX=
# Printed by create-ozone-did.mjs
OZONE_SERVER_DID=
OZONE_ADMIN_PASSWORD=
# Comma-separated DIDs of the moderators' accounts
OZONE_ADMIN_DIDS=

# --- Krao services ---------------------------------------------------------
# Shared by the PDS and rewards (at least 32 characters)
KRAO_REWARDS_INTERNAL_TOKEN=
# Signs gated media URLs (at least 32 characters)
KRAO_GATE_MEDIA_SECRET=
# The AppView's key for the push service, and Krao services' token for it
KRAO_PUSH_COURIER_KEY=
KRAO_PUSH_INTERNAL_TOKEN=
# Chains the indexer checks (tips, gates, NFTs, smart wallet links): JSON
# {chain id: RPC URL}
KRAO_RPC_URLS={"eip155:8453":"https://mainnet.base.org"}
# Base RPC for the PDS: sign-in with smart contract wallets (Coinbase Smart
# Wallet and other ERC-1271/6492 wallets). Empty: plain wallets only
KRAO_BASE_RPC_URL=https://mainnet.base.org
KRAO_KLIPY_API_KEY=
# A campaign code for the first accounts (the admins); remove it, and
# disable the code in the admin screen, once they have signed up
KRAO_REWARDS_BOOTSTRAP_CODE=
KRAO_REWARDS_ADMIN_DIDS=
KRAO_KYC_REVIEWER_DIDS=
KRAO_KYC_MANUAL_DAILY_LIMIT=
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=
SUMSUB_LEVEL=

# --- Phone verification (Decree 147) ---------------------------------------
# Posting and chat need a verified phone number. SMS gateway: http (POST
# {to, text} with the bearer token below to any gateway or relay). The log
# driver is for development only (it needs KRAO_DEV_MODE): until a gateway is
# chosen, nobody can verify a phone, so nobody can post or chat.
KRAO_SMS_PROVIDER=http
KRAO_SMS_HTTP_URL=
KRAO_SMS_HTTP_TOKEN=
# Countries whose numbers are accepted (comma-separated prefixes)
KRAO_PHONE_ALLOWED_PREFIXES=+84
# SMS budget: codes per hour in total, and per client address
KRAO_SMS_GLOBAL_HOURLY_CAP=500
KRAO_SMS_IP_HOURLY_CAP=30
# Keys the stored numbers (at least 32 characters). Changing it loses them
KRAO_PHONE_HMAC_SECRET=
# Encrypts the numbers kept for the authorities: openssl rand -hex 32
KRAO_PHONE_ENC_KEY=

# --- Gated content moderation ----------------------------------------------
# Accounts (besides Ozone) that may read gated content, comma-separated.
# Every read is logged; false turns moderator access off.
KRAO_GATE_MODERATOR_DIDS=
KRAO_GATE_MODERATION_ACCESS=true

# --- Safety ------------------------------------------------------------------
# Open phishing/drainer domain list, synced every 6 hours, in the shape of
# MetaMask's eth-phishing-detect config.json, eg
# https://raw.githubusercontent.com/MetaMask/eth-phishing-detect/main/src/config.json
# Empty: only built-in and admin-added domains.
KRAO_PHISHING_LIST_URL=
# Accounts that may add and remove unsafe domains and catalog tokens
# (net.krao.token.admin.*), comma-separated
KRAO_SAFETY_ADMIN_DIDS=
# Token prices for cashtags come from Uniswap v3 pools on Base (through
# KRAO_RPC_URLS). Empty: Uniswap's Base factory, a price every 5 minutes.
KRAO_UNISWAP_V3_FACTORY=
KRAO_TOKEN_PRICE_INTERVAL_MS=
# Ethereum mainnet RPC for verified ENS names next to handles. Empty: only
# Basenames (read through the Base RPC in KRAO_RPC_URLS)
KRAO_ENS_RPC_URL=
# "Holders of $X" feeds: the US dollar value of a catalog token an account's
# wallets must hold for its posts to be in the token's feed. Empty: 1
KRAO_HOLDER_FEED_MIN_USD=
# Krao's verifier accounts: their app.bsky.graph.verification records give
# the blue check (eg the official Krao account), comma-separated
KRAO_TRUSTED_VERIFIER_DIDS=

# --- S3 (gated media and backups) ------------------------------------------
# Any S3-compatible store (AWS, Cloudflare R2, Backblaze B2, MinIO).
# The gated media bucket must be private.
KRAO_S3_ACCESS_KEY_ID=
KRAO_S3_SECRET_ACCESS_KEY=
KRAO_GATE_MEDIA_S3_BUCKET=
KRAO_GATE_MEDIA_S3_REGION=
KRAO_GATE_MEDIA_S3_ENDPOINT=
KRAO_GATE_MEDIA_S3_PATH_STYLE=

# --- Push notifications ----------------------------------------------------
# Files in ./secrets (mounted at /secrets). Without both, pushes are logged.
# Android: a Firebase service account JSON for the io.krao.app project
KRAO_PUSH_FCM_SERVICE_ACCOUNT_FILE=
# iOS: an APNs auth key (.p8) with its key id and team id
KRAO_PUSH_APNS_KEY_FILE=
KRAO_PUSH_APNS_KEY_ID=
KRAO_PUSH_APNS_TEAM_ID=
KRAO_PUSH_APNS_TOPIC=io.krao.app

# --- Backups ---------------------------------------------------------------
KRAO_BACKUP_DIR=./backups
KRAO_BACKUP_EVERY_HOURS=24
KRAO_BACKUP_KEEP=7
# Also copy each backup to this bucket (recommended: another provider)
KRAO_BACKUP_S3_BUCKET=
KRAO_BACKUP_S3_REGION=
KRAO_BACKUP_S3_ENDPOINT=

# --- Monitoring ------------------------------------------------------------
# Alerts when a service goes down or recovers (once per change, a reminder
# every KRAO_ALERT_REPEAT_HOURS while down). Unset: alerts only in the
# monitor's log. json posts {source, domain, text, events}; telegram posts
# to https://api.telegram.org/bot<token>/sendMessage with the chat id below.
KRAO_ALERT_WEBHOOK_URL=
KRAO_ALERT_FORMAT=json
KRAO_ALERT_TELEGRAM_CHAT_ID=
KRAO_ALERT_REPEAT_HOURS=6
KRAO_MONITOR_INTERVAL_SEC=60
KRAO_MONITOR_DISK_MAX_PERCENT=85
KRAO_MONITOR_BACKUP_MAX_AGE_HOURS=48
# Seconds without a firehose event before the indexer counts as stuck (a
# quiet network looks the same: raise it while there is little traffic)
KRAO_MONITOR_FIREHOSE_MAX_AGE_SEC=21600
